# Backend environment variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=AI DevOps Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# AI generation (Groq is the default; leave the key blank to use local templates)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional alternative provider (set LLM_PROVIDER=openai to select it)
OPENAI_API_KEY=

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=devops_assistant

# Redis
REDIS_HOST=localhost
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
